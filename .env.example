# Copier ce fichier en .env puis renseigner les valeurs
DEBUG=True
SECRET_KEY=changer-cette-cle
ALLOWED_HOSTS=127.0.0.1,localhost

# MariaDB 11.4 (port 3307)
DB_NAME=formation_tunisie
DB_USER=formation_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307

# Production uniquement (HTTPS) : cookies sécurisés. Par défaut : activés si DEBUG=False.
# COOKIES_SECURISES=True

# Envoi des emails (mot de passe oublié). Par défaut : affichés dans la console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.tn
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Centre de formation <contact@exemple.tn>

# Dossier des documents réservés aux inscrits (hors du dossier media public)
# FICHIERS_PRIVES_ROOT=C:/chemin/vers/fichiers_prives
